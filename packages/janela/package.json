{
  "name": "janela",
  "version": "0.6.0",
  "description": "Desktop apps in pure TypeScript, compiled to native. No Rust, no Node, no Electron.",
  "type": "module",
  "bin": {
    "janela": "bin/janela.mjs",
    "jn": "bin/janela.mjs"
  },
  "exports": {
    "./api": {
      "types": "./api/index.d.ts",
      "default": "./api/index.js"
    },
    "./host": {
      "types": "./runtime/janela.ts"
    },
    "./global": {
      "types": "./api/global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "scriptc": "0.0.35"
  },
  "license": "MIT",
  "author": "Mateus Lage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmamedel/janela.git"
  },
  "homepage": "https://mmamedel.github.io/janela/",
  "bugs": {
    "url": "https://github.com/mmamedel/janela/issues"
  },
  "keywords": [
    "desktop",
    "webview",
    "typescript",
    "native",
    "tauri",
    "electron-alternative",
    "scriptc"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "api/",
    "bin/",
    "runtime/",
    "shim/",
    "templates/",
    "vendor-webview/core/include/",
    "vendor-webview/LICENSE"
  ]
}
